# Copy this to .env and fill in when you're ready to go from mock to real.
# With nothing set, the app runs fully in mock mode — no real accounts needed.

# --- Database ---
# Leave unset to use local SQLite. For Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/lipila?sslmode=require
DATABASE_URL=

# --- Redis (Dynamic QR + Bong TTLs) ---
# Leave unset to use an in-memory fallback. For a real Redis (e.g. Upstash):
# REDIS_URL=redis://default:password@your-redis-host:6379
REDIS_URL=

# --- Payment provider ---
# "mock" (default) = fully simulated, works with zero setup.
# "mtn" = real MTN MoMo Collections/Disbursements sandbox or production.
PAYMENT_PROVIDER=mock

# Only needed when PAYMENT_PROVIDER=mtn. Get these from
# https://momodeveloper.mtn.com after registering Collections + Disbursements products.
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com

# --- CORS ---
# Set to your deployed frontend URL in production.
FRONTEND_ORIGIN=http://localhost:5173
